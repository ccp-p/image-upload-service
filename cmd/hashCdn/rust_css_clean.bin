    z-index: 1000;
    display: none;
}

.gz-confirm-dialog {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 6.12rem;
    transform: translate(-50%, -50%);
    -webkit-transform: translate(-50%, -50%);
