    width: 6.75rem;
    height: 7.81rem;
    background-size: 100% 100%;
}

.level-award-tips {
    font-family: HarmonyOS Sans SC;
    font-weight: 400;
    font-size: 0.22rem;
    color: #999999;
    line-height: 0.18rem;
    margin-left: 0.27rem;
}

.new-year .level-award-tips {
    color: #333333;
}

.level-ball .ball {
    position: absolute;
    top: 0.8rem;
    left: 0.2rem;
    width: 6.9rem;
    height: 2.24rem;
}

.level-phone .left,
.level-phone .right {
